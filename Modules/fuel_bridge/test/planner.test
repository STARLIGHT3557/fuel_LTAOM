<launch>
  <include file="$(find prometheus_fuel)/launch/fuel.launch">
    <arg name="rviz" value="false"/>
    <arg name="odom_topic" value="/fuel_test/odom"/>
    <arg name="cloud_topic" value="/fuel_test/cloud"/>
  </include>
  <test test-name="fuel_planner_smoke" pkg="prometheus_fuel" type="test_planner.py" time-limit="90"/>
</launch>
