<launch>
  <arg name="uav_id" default="1"/>
  <arg name="odom_topic" default="/uav$(arg uav_id)/prometheus/odom"/>
  <arg name="cloud_topic" default="/livox/lidar_mapping"/>
  <arg name="lidar_frame" default="uav1/lidar_link"/>
  <arg name="map_size_x" default="48.0"/>
  <arg name="map_size_y" default="32.0"/>
  <arg name="map_size_z" default="6.0"/>
  <arg name="spawn_x" default="-10.0"/>
  <arg name="spawn_y" default="0.0"/>
  <!-- planning_easy2 cylinder field plus the western takeoff entrance.
       Convert Gazebo bounds to PX4/Prometheus local ENU coordinates. -->
  <arg name="box_min_x" default="$(eval -11.0 - float(arg('spawn_x')))"/>
  <arg name="box_min_y" default="$(eval -11.0 - float(arg('spawn_y')))"/>
  <arg name="box_min_z" default="0.5"/>
  <arg name="box_max_x" default="$(eval 12.0 - float(arg('spawn_x')))"/>
  <arg name="box_max_y" default="$(eval 10.0 - float(arg('spawn_y')))"/>
  <arg name="box_max_z" default="2.5"/>
  <arg name="max_vel" default="1.0"/>
  <arg name="max_acc" default="1.0"/>
  <arg name="rviz" default="true"/>
  <include file="$(find prometheus_gazebo)/launch_basic/sitl_outdoor_1uav_P600_mid360.launch">
    <arg name="uav1_id" value="$(arg uav_id)"/>
    <arg name="uav_id" value="$(arg uav_id)"/>
    <arg name="rviz_enable" value="false"/>
    <arg name="uav1_init_x" value="$(arg spawn_x)"/>
    <arg name="uav1_init_y" value="$(arg spawn_y)"/>
  </include>
  <include file="$(find prometheus_uav_control)/launch/uav_control_main_outdoor.launch">
    <arg name="uav_id" value="$(arg uav_id)"/>
  </include>
  <node pkg="prometheus_fuel" type="fuel_runtime.sh" name="fuel_runtime"
        output="screen" required="true"
        args="uav_id:=$(arg uav_id) odom_topic:=$(arg odom_topic) cloud_topic:=$(arg cloud_topic) lidar_frame:=$(arg lidar_frame) map_size_x:=$(arg map_size_x) map_size_y:=$(arg map_size_y) map_size_z:=$(arg map_size_z) box_min_x:=$(arg box_min_x) box_min_y:=$(arg box_min_y) box_min_z:=$(arg box_min_z) box_max_x:=$(arg box_max_x) box_max_y:=$(arg box_max_y) box_max_z:=$(arg box_max_z) max_vel:=$(arg max_vel) max_acc:=$(arg max_acc) rviz:=$(arg rviz)"/>
</launch>
