<launch>
  <arg name="params_file" default="$(find uav_controller)/config/params.yaml" />
  <arg name="fsm_params_file" default="$(find uav_controller)/config/fsm.yaml" />
  <!-- Feedback source must match the odometry the planner uses. Planning on one
       estimator while closing the loop on another makes the two frames drift
       apart until the position loop diverges. -->
  <arg name="pose_topic" default="/mavros/local_position/pose" />
  <arg name="velocity_topic" default="/mavros/local_position/velocity_local" />

  <node pkg="uav_controller" type="geometric_controller_node"
        name="geometric_controller_node" output="screen">
    <rosparam command="load" file="$(arg params_file)" />
    <rosparam command="load" file="$(arg fsm_params_file)" />
    <param name="pose_topic" value="$(arg pose_topic)" />
    <param name="velocity_topic" value="$(arg velocity_topic)" />
  </node>
</launch>
