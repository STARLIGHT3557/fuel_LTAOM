Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 35; 35; 35
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
    - Class: rviz/PointCloud2
      Name: Saved PCD
      Enabled: true
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Topic: /saved_map/points
      Queue Size: 2
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 20
      Pitch: 0.8
      Yaw: 0.8
      Focal Point: {X: 0, Y: 0, Z: 1}
