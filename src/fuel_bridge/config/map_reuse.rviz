Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Fixed Frame: world
    Background Color: 35; 35; 35
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
    - Class: rviz/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 1
    - Class: rviz/PointCloud2
      Name: Occupancy grid
      Enabled: true
      Position Transformer: XYZ
      Topic: /sdf_map/occupancy_all
      Queue Size: 2
      Size (m): 0.2
      Style: Boxes
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz/PointCloud2
      Name: Raw hits (world)
      Enabled: true
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 0; 200; 255
      Topic: /fuel/cloud_hits_world
      Queue Size: 2
      Size (Pixels): 2
      Size (m): 0.04
      Style: Points
    - Class: rviz/Path
      Name: LIO path
      Enabled: true
      Topic: /laserMapping/path
      Color: 255; 170; 0
      Line Style: Lines
      Line Width: 0.03
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Pitch: 0.8
      Yaw: 0.8
      Focal Point: {X: 0, Y: 0, Z: 0}
