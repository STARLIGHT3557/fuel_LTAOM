<launch>
  <group ns="fuel">
    <node pkg="fuel_bridge" type="mission_manager_node" name="mission_manager" required="true">
      <rosparam command="load" file="$(find fuel_bridge)/config/mission.yaml"/>
      <param name="exploration/initial_plan_timeout" value="1.2"/>
      <param name="exploration/planner_status_timeout" value="0.4"/>
      <param name="battery/return_threshold" value="0.30"/>
      <param name="return_home/planning_timeout" value="1.2"/>
      <param name="return_home/retry_interval" value="0.1"/>
      <param name="return_home/stable_time" value="1.5"/>
      <param name="return_home/arrival_timeout" value="0.5"/>
    </node>
  </group>
  <test test-name="exploration_timeouts" pkg="fuel_bridge" type="test_exploration_timeouts.py" time-limit="60"/>
</launch>
