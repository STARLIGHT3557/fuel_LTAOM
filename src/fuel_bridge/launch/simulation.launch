<launch>
  <arg name="uav_id" default="1"/>
  <arg name="odom_topic" default="/uav$(arg uav_id)/mavros/local_position/odom"/>
  <arg name="cloud_topic" default="/livox/lidar_mapping"/>
  <arg name="lidar_frame" default="uav$(arg uav_id)/lidar_link"/>
  <!-- A dictionary lookup rejects unsupported scene names. -->
  <arg name="scene" default="cylinder"/>
  <arg name="world_file" value="$(eval find('prometheus_gazebo') + '/gazebo_worlds/planning_worlds/' + {'cylinder': 'planning_easy2.world', 'indoor4': 'indoor4.world'}[arg('scene')])"/>
  <arg name="map_size_x" default="$(eval {'cylinder': 48.0, 'indoor4': 80.0}[arg('scene')])"/>
  <arg name="map_size_y" default="$(eval {'cylinder': 32.0, 'indoor4': 64.0}[arg('scene')])"/>
  <arg name="map_size_z" default="6.0"/>
  <arg name="spawn_x" default="$(eval {'cylinder': -10.0, 'indoor4': 0.0}[arg('scene')])"/>
  <arg name="spawn_y" default="$(eval {'cylinder': 0.0, 'indoor4': -1.0}[arg('scene')])"/>
  <!-- Convert Gazebo field bounds to PX4/Prometheus local ENU coordinates. -->
  <arg name="box_min_x" default="$(eval {'cylinder': -11.0, 'indoor4': -15.0}[arg('scene')] - float(arg('spawn_x')))"/>
  <arg name="box_min_y" default="$(eval {'cylinder': -11.0, 'indoor4': -15.0}[arg('scene')] - float(arg('spawn_y')))"/>
  <arg name="box_min_z" default="0.5"/>
  <arg name="box_max_x" default="$(eval {'cylinder': 12.0, 'indoor4': 10.0}[arg('scene')] - float(arg('spawn_x')))"/>
  <arg name="box_max_y" default="$(eval {'cylinder': 10.0, 'indoor4': 10.0}[arg('scene')] - float(arg('spawn_y')))"/>
  <!-- Keep indoor flight goals below the 2.5 m maze walls. -->
  <arg name="box_max_z" default="$(eval {'cylinder': 2.5, 'indoor4': 2.0}[arg('scene')])"/>
  <arg name="max_vel" default="1.0"/>
  <arg name="max_acc" default="1.0"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <include file="$(find prometheus_gazebo)/launch/p600_mid360.launch">
    <arg name="uav_id" value="$(arg uav_id)"/>
    <arg name="spawn_x" value="$(arg spawn_x)"/>
    <arg name="spawn_y" value="$(arg spawn_y)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="world_file" value="$(arg world_file)"/>
  </include>
  <group>
    <remap from="/mavros/local_position/pose" to="/uav$(arg uav_id)/mavros/local_position/pose"/>
    <remap from="/mavros/local_position/velocity_local" to="/uav$(arg uav_id)/mavros/local_position/velocity_local"/>
    <remap from="/mavros/imu/data" to="/uav$(arg uav_id)/mavros/imu/data"/>
    <remap from="/mavros/state" to="/uav$(arg uav_id)/mavros/state"/>
    <remap from="/mavros/extended_state" to="/uav$(arg uav_id)/mavros/extended_state"/>
    <remap from="/mavros/setpoint_raw/attitude" to="/uav$(arg uav_id)/mavros/setpoint_raw/attitude"/>
    <include file="$(find uav_controller)/launch/geometric_controller.launch">
      <arg name="params_file" value="$(find prometheus_fuel)/config/uav_controller_p600.yaml"/>
    </include>
  </group>
  <include file="$(find prometheus_fuel)/launch/fuel.launch">
    <arg name="uav_id" value="$(arg uav_id)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>
    <arg name="lidar_frame" value="$(arg lidar_frame)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="box_min_x" value="$(arg box_min_x)"/>
    <arg name="box_min_y" value="$(arg box_min_y)"/>
    <arg name="box_min_z" value="$(arg box_min_z)"/>
    <arg name="box_max_x" value="$(arg box_max_x)"/>
    <arg name="box_max_y" value="$(arg box_max_y)"/>
    <arg name="box_max_z" value="$(arg box_max_z)"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="rviz" value="$(arg rviz)"/>
  </include>
</launch>
