<launch>
  <arg name="uav_id" default="1"/>
  <arg name="odom_topic" default="/uav$(arg uav_id)/prometheus/odom"/>
  <arg name="cloud_topic" default="/livox/lidar_mapping"/>
  <arg name="lidar_frame" default="uav$(arg uav_id)/lidar_link"/>
  <arg name="map_size_x" default="48.0"/>
  <arg name="map_size_y" default="32.0"/>
  <arg name="map_size_z" default="6.0"/>
  <arg name="spawn_x" default="-10.0"/>
  <arg name="spawn_y" default="0.0"/>
  <!-- planning_easy2 cylinder field plus the western takeoff entrance.
       Convert Gazebo bounds to PX4/Prometheus local ENU coordinates. -->
  <arg name="box_min_x" default="$(eval -11.0 - float(arg('spawn_x')))"/>
  <arg name="box_min_y" default="$(eval -11.0 - float(arg('spawn_y')))"/>
  <arg name="box_min_z" default="0.5"/>
  <arg name="box_max_x" default="$(eval 12.0 - float(arg('spawn_x')))"/>
  <arg name="box_max_y" default="$(eval 10.0 - float(arg('spawn_y')))"/>
  <arg name="box_max_z" default="2.5"/>
  <arg name="max_vel" default="1.0"/>
  <arg name="max_acc" default="1.0"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <include file="$(find prometheus_gazebo)/launch/p600_mid360.launch">
    <arg name="uav_id" value="$(arg uav_id)"/>
    <arg name="spawn_x" value="$(arg spawn_x)"/>
    <arg name="spawn_y" value="$(arg spawn_y)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>
  <include file="$(find prometheus_uav_control)/launch/control.launch">
    <arg name="uav_id" value="$(arg uav_id)"/>
  </include>
  <include file="$(find prometheus_fuel)/launch/fuel.launch">
    <arg name="uav_id" value="$(arg uav_id)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>
    <arg name="lidar_frame" value="$(arg lidar_frame)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="box_min_x" value="$(arg box_min_x)"/>
    <arg name="box_min_y" value="$(arg box_min_y)"/>
    <arg name="box_min_z" value="$(arg box_min_z)"/>
    <arg name="box_max_x" value="$(arg box_max_x)"/>
    <arg name="box_max_y" value="$(arg box_max_y)"/>
    <arg name="box_max_z" value="$(arg box_max_z)"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="rviz" value="$(arg rviz)"/>
  </include>
</launch>
