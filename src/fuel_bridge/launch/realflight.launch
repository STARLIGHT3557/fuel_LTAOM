<launch>
  <!-- 实飞入口：控制器 + FUEL。以下参数都可以在启动命令后用 名称:=值 临时覆盖，
       例如 bash start_realflight.sh max_vel:=0.5 rviz:=false。
       参数说明见 docs/REALFLIGHT_PARAMETERS.md。 -->
  <!-- 雷达外参，由 fuel_realflight.sh 调用 prepare_realflight.py 从 LIO 配置自动生成。 -->
  <arg name="sensor_config"/>
  <!-- 控制器增益与悬停油门 -->
  <arg name="controller_params" default="$(find fuel_bridge)/config/uav_controller_realflight.yaml"/>
  <!-- 返航点、电量阈值与超时 -->
  <arg name="mission_config" default="$(find fuel_bridge)/config/mission.yaml"/>
  <!-- 相机视野裁剪 -->
  <arg name="view_config" default="$(find fuel_bridge)/config/view_crop.yaml"/>
  <!-- 建图与规划坐标系，必须与 MAVROS 里程计的 frame_id 一致 -->
  <arg name="world_frame" default="map"/>
  <arg name="odom_topic" default="/mavros/local_position/odom"/>
  <!-- MAVROS 里程计速度在机体系，规划需要转换到世界系 -->
  <arg name="odom_twist_in_body" default="true"/>
  <!-- Faster-LIO 去畸变点云（LIO IMU 坐标系） -->
  <arg name="cloud_topic" default="/laserMapping/cloud_registered_body"/>
  <arg name="battery_topic" default="/mavros/battery"/>
  <!-- FUEL 地图尺寸（m）。地图以原点为中心：x、y 范围为 ±size/2，z 从 ground_height 起；
       必须完整包含下面的探索边界。 -->
  <arg name="map_size_x" default="50.0"/>
  <arg name="map_size_y" default="50.0"/>
  <arg name="map_size_z" default="6.0"/>
  <!-- 探索边界（本地 ENU，m）：规划和视点只在此范围内；box_min_z 也是最低飞行高度。
       注意当前 box_max_x=40 超出 map_size_x=60 的地图范围（x≤30）。 -->
  <arg name="box_min_x" default="-10.0"/>
  <arg name="box_min_y" default="-2.5"/>
  <arg name="box_min_z" default="0.1"/>
  <arg name="box_max_x" default="20.0"/>
  <arg name="box_max_y" default="20.0"/>
  <arg name="box_max_z" default="2.5"/>
  <!-- 规划最大速度（m/s）和加速度（m/s²），首飞建议降低 -->
  <arg name="max_vel" default="1.0"/>
  <arg name="max_acc" default="0.4"/>
  <!-- 是否启动 FUEL 的 RViz，无图形环境时设为 false -->
  <arg name="rviz" default="true"/>
  <!-- 多会话地图复用：fresh=单次运行，save=首次运行并保存，load=加载已有地图续用。 -->
  <arg name="session" default="fresh"/>
  <arg name="map_prior_dir" default="$(env HOME)/fuel_sim_logs"/>

  <param name="use_sim_time" value="false"/>
  <include file="$(find uav_controller)/launch/geometric_controller.launch">
    <arg name="params_file" value="$(arg controller_params)"/>
  </include>
  <!-- 实飞固定为 FUEL 直接轨迹模式：空中切 OFFBOARD 后悬停，只执行任务管理器授权的轨迹。 -->
  <param name="geometric_controller_node/fsm/direct_trajectory" value="true"/>
  <param name="geometric_controller_node/fsm/position_step" value="false"/>
  <include file="$(find fuel_bridge)/launch/fuel.launch">
    <arg name="sensor_config" value="$(arg sensor_config)"/>
    <arg name="mission_config" value="$(arg mission_config)"/>
    <arg name="view_config" value="$(arg view_config)"/>
    <arg name="world_frame" value="$(arg world_frame)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="odom_twist_in_body" value="$(arg odom_twist_in_body)"/>
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>
    <arg name="battery_topic" value="$(arg battery_topic)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="box_min_x" value="$(arg box_min_x)"/>
    <arg name="box_min_y" value="$(arg box_min_y)"/>
    <arg name="box_min_z" value="$(arg box_min_z)"/>
    <arg name="box_max_x" value="$(arg box_max_x)"/>
    <arg name="box_max_y" value="$(arg box_max_y)"/>
    <arg name="box_max_z" value="$(arg box_max_z)"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="session" value="$(arg session)"/>
    <arg name="map_prior_dir" value="$(arg map_prior_dir)"/>
  </include>
</launch>
