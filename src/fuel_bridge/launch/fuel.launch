<launch>
  <arg name="world_frame" default="world"/>
  <arg name="sensor_config" default="$(find fuel_bridge)/config/bridge.yaml"/>
  <arg name="mission_config" default="$(find fuel_bridge)/config/mission.yaml"/>
  <!-- Camera view crop shared by the bridge map input and FUEL visibility. -->
  <arg name="view_config" default="$(find fuel_bridge)/config/view_crop.yaml"/>
  <arg name="odom_topic" default="/mavros/local_position/odom"/>
  <!-- MAVROS Odometry twist is body-frame; FUEL planning uses world ENU. -->
  <arg name="odom_twist_in_body" default="true"/>
  <arg name="cloud_topic" default="/laserMapping/cloud_registered_body"/>
  <arg name="battery_topic" default="/mavros/battery"/>
  <arg name="lidar_frame" default="lidar_link"/>
  <arg name="map_size_x" default="48.0"/>
  <arg name="map_size_y" default="32.0"/>
  <arg name="map_size_z" default="6.0"/>
  <!-- Local MAVROS ENU mission bounds; set these for the actual flight area. -->
  <arg name="box_min_x" default="-5.0"/>
  <arg name="box_min_y" default="-5.0"/>
  <arg name="box_min_z" default="0.5"/>
  <arg name="box_max_x" default="5.0"/>
  <arg name="box_max_y" default="5.0"/>
  <arg name="box_max_z" default="2.0"/>
  <arg name="max_vel" default="0.5"/>
  <arg name="max_acc" default="0.5"/>
  <arg name="rviz" default="true"/>
  <!-- 多会话地图复用：fresh=单次运行，save=首次运行并保存，load=加载已有地图续用。 -->
  <arg name="session" default="fresh"/>
  <arg name="map_prior_dir" default="$(env HOME)/fuel_sim_logs"/>
  <arg name="map_load_path"
       default="$(eval {'fresh': '', 'save': '', 'load': arg('map_prior_dir') + '/map_prior/occ_map.bin'}[arg('session')])"/>
  <arg name="map_save_path"
       default="$(eval {'fresh': '', 'save': arg('map_prior_dir') + '/map_prior/occ_map.bin', 'load': arg('map_prior_dir') + '/map_prior/occ_map.bin'}[arg('session')])"/>
  <arg name="pcd_load_path"
       default="$(eval {'fresh': '', 'save': '', 'load': arg('map_prior_dir') + '/map_prior/merged_map.pcd'}[arg('session')])"/>
  <arg name="pcd_save_path"
       default="$(eval {'fresh': '', 'save': arg('map_prior_dir') + '/map_prior/merged_map.pcd', 'load': arg('map_prior_dir') + '/map_prior/merged_map.pcd'}[arg('session')])"/>
  <include file="$(find exploration_manager)/launch/algorithm.xml">
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="box_min_x" value="$(arg box_min_x)"/>
    <arg name="box_min_y" value="$(arg box_min_y)"/>
    <arg name="box_min_z" value="$(arg box_min_z)"/>
    <arg name="box_max_x" value="$(arg box_max_x)"/>
    <arg name="box_max_y" value="$(arg box_max_y)"/>
    <arg name="box_max_z" value="$(arg box_max_z)"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="odometry_topic" value="$(arg odom_topic)"/>
    <arg name="sensor_pose_topic" value="/fuel/sensor_pose"/>
    <arg name="cloud_topic" value="/fuel/cloud_world"/>
    <arg name="depth_topic" value="/fuel/unused_depth"/>
    <!-- Unused by the point-cloud input path. -->
    <arg name="cx" value="320.0"/><arg name="cy" value="240.0"/>
    <arg name="fx" value="387.0"/><arg name="fy" value="387.0"/>
  </include>
  <!-- Override camera-demo parameters after loading the upstream algorithm. -->
  <rosparam ns="exploration_node" command="load" file="$(find fuel_bridge)/config/exploration.yaml"/>
  <rosparam ns="exploration_node" command="load" file="$(arg mission_config)"/>
  <rosparam ns="exploration_node" command="load" file="$(arg sensor_config)"/>
  <rosparam ns="exploration_node" command="load" file="$(arg view_config)"/>
  <param name="exploration_node/world_frame" value="$(arg world_frame)"/>
  <param name="exploration_node/map_ros/frame_id" value="$(arg world_frame)"/>
  <param name="exploration_node/map_ros/map_load_path" value="$(arg map_load_path)"/>
  <param name="exploration_node/map_ros/map_save_path" value="$(arg map_save_path)"/>
  <param name="exploration_node/map_ros/pcd_load_path" value="$(arg pcd_load_path)"/>
  <param name="exploration_node/map_ros/pcd_save_path" value="$(arg pcd_save_path)"/>
  <param name="exploration_node/odom_twist_in_body" value="$(arg odom_twist_in_body)"/>
  <param name="exploration_node/exploration/tsp_dir" value="$(env FUEL_TSP_DIR)"/>
  <!-- 预配置 LTAOM 流水线（FAST-LIO + STD + loop_optimization），供
       ltaom_multisession.launch 以相同 session/map_prior_dir 启动时使用。 -->
  <param name="multisession_mode" value="$(eval {'fresh': 0, 'save': 2, 'load': 1}[arg('session')])"/>
  <param name="SaveDir" value="$(arg map_prior_dir)/ltaom/"/>
  <node pkg="plan_manage" type="traj_server" name="fuel_traj_server" output="screen" required="true">
    <remap from="/position_cmd" to="/fuel/position_cmd"/>
    <remap from="/odom_world" to="$(arg odom_topic)"/>
    <param name="traj_server/pub_traj_id" value="4"/>
    <param name="fsm/replan_time" value="0.2"/>
    <rosparam command="load" file="$(arg mission_config)"/>
    <param name="world_frame" value="$(arg world_frame)"/>
  </node>
  <group ns="fuel">
    <node pkg="fuel_bridge" type="mission_manager_node" name="mission_manager"
          output="screen" required="true">
      <rosparam command="load" file="$(arg mission_config)"/>
      <param name="world_frame" value="$(arg world_frame)"/>
      <param name="session" value="$(arg session)"/>
      <param name="multisession/map_save_topic" value="/save_occ_map"/>
      <param name="multisession/prior_save_param" value="/save_prior_info"/>
      <remap from="odom" to="$(arg odom_topic)"/>
      <remap from="control_state" to="/uav_controller/fsm_status"/>
      <remap from="battery" to="$(arg battery_topic)"/>
      <remap from="goal" to="/move_base_simple/goal"/>
    </node>
    <node pkg="fuel_bridge" type="fuel_bridge" name="bridge" output="screen" required="true">
      <rosparam command="load" file="$(arg mission_config)"/>
      <rosparam command="load" file="$(find fuel_bridge)/config/bridge.yaml"/>
      <rosparam command="load" file="$(arg sensor_config)"/>
      <rosparam command="load" file="$(arg view_config)"/>
      <param name="lidar_frame" value="$(arg lidar_frame)"/>
      <param name="box_min_x" value="$(arg box_min_x)"/>
      <param name="box_min_y" value="$(arg box_min_y)"/>
      <param name="box_min_z" value="$(arg box_min_z)"/>
      <param name="box_max_x" value="$(arg box_max_x)"/>
      <param name="box_max_y" value="$(arg box_max_y)"/>
      <param name="box_max_z" value="$(arg box_max_z)"/>
      <param name="world_frame" value="$(arg world_frame)"/>
      <remap from="odom" to="$(arg odom_topic)"/>
      <remap from="cloud" to="$(arg cloud_topic)"/>
      <remap from="control_state" to="/uav_controller/fsm_status"/>
      <remap from="command" to="/uav_controller/trajectory_setpoint"/>
      <remap from="trigger" to="/waypoint_generator/waypoints"/>
    </node>
  </group>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="fuel_rviz"
        args="-d $(find fuel_bridge)/config/fuel.rviz -f $(arg world_frame)">
    <remap from="/mavros/local_position/odom" to="$(arg odom_topic)"/>
  </node>
</launch>
