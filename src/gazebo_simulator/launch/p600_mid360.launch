<launch>
  <arg name="uav_id" default="1"/>
  <arg name="spawn_x" default="-10.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="world_file" default="$(find prometheus_gazebo)/gazebo_worlds/planning_worlds/planning_easy2.world"/>
  <arg name="gui" default="true"/>
  <arg name="ID" value="$(eval arg('uav_id') - 1)"/>
  <arg name="tcp_port" value="$(eval 4560 + arg('ID'))"/>
  <arg name="udp_port" value="$(eval 14560 + arg('ID'))"/>
  <arg name="offboard_remote" value="$(eval 14540 + arg('ID'))"/>
  <arg name="offboard_local" value="$(eval 14580 + arg('ID'))"/>
  <env name="PX4_SIM_MODEL" value="p600_mid360"/>
  <env name="PX4_ESTIMATOR" value="ekf2"/>
  <env name="PX4_SIM_SPEED_FACTOR" value="1.0"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_file)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>
  <group>
    <param name="p600_sdf" command="'$(find prometheus_gazebo)/scripts/jinja_gen.py' --mavlink_id=$(arg uav_id) --mavlink_tcp_port=$(arg tcp_port) --mavlink_udp_port=$(arg udp_port) '$(find prometheus_gazebo)/gazebo_models/uav_models/p600_mid360/p600_mid360.sdf.jinja'"/>
    <node name="sitl" pkg="prometheus_gazebo" type="px4_sitl.sh" output="screen" required="true" args="$(arg ID)"/>
    <node name="spawn" pkg="gazebo_ros" type="spawn_model" output="screen"
          args="-sdf -param p600_sdf -model p600_mid360_$(arg ID) -x $(arg spawn_x) -y $(arg spawn_y) -z 0.15"/>
    <node name="mavros" pkg="mavros" type="mavros_node" output="screen" required="true">
      <param name="fcu_url" value="udp://:$(arg offboard_remote)@localhost:$(arg offboard_local)"/>
      <param name="gcs_url" value=""/>
      <param name="target_system_id" value="$(arg uav_id)"/>
      <param name="target_component_id" value="1"/>
      <rosparam command="load" file="$(find prometheus_gazebo)/config/mavros_config/px4_config_outdoor.yaml"/>
      <rosparam command="load" file="$(find prometheus_gazebo)/config/mavros_config/px4_pluginlists_outdoor.yaml"/>
    </node>
  </group>
</launch>
