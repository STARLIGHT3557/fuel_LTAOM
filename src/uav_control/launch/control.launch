<launch>
  <arg name="uav_id" default="1"/>
  <node pkg="prometheus_uav_control" type="uav_control_main" name="uav_control_main_$(arg uav_id)" output="screen" required="true">
    <param name="uav_id" value="$(arg uav_id)"/>
    <rosparam command="load" file="$(find prometheus_uav_control)/config/p600.yaml"/>
  </node>
</launch>
